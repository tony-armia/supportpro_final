+  const rotate = useTransform(progress, [0, 0.5, 1], [0, finalRotate, 0]);
+  const x = useTransform(progress, [0, 0.5, 1], [0, finalX, offset * 270]);
+  const y = useTransform(progress, [0, 0.5, 1], [0, finalY, 0]);

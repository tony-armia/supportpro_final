@@ -0,0 +1,93 @@
+.magic-badge {
+  position: relative;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  transition: border-color 250ms ease, background-color 250ms ease;
+  overflow: visible;
+
+  --glow-x: 50%;
+  --glow-y: 50%;
+  --glow-intensity: 0;
+  --glow-radius: 150px;
+  --glow-color: 255, 129, 1; /* #FF8101 */
+}
+
+.particle-badge-wrapper {
+  position: relative;
+  display: inline-flex;
+  isolation: isolate;
+  will-change: transform, box-shadow;
+  /* Removed base border/glow/background as they are handled by the component style props */
+}
+
+.particle-badge-glow {
+  position: absolute;
+  inset: -1px; /* Matches the 1px border */
+  border-radius: inherit;
+  z-index: 1;
+  pointer-events: none;
+  opacity: 0;
+  will-change: opacity, background;
+  mix-blend-mode: var(--blend-mode);
+}
+
+.magic-badge:hover {
+  transform: translateY(-1px) translateZ(0);
+  /* No box-shadow ΓÇö depth via border only on dark bg */
+}
+
+/* Border glow effect */
+.magic-badge--border-glow::after {
+  content: '';
+  position: absolute;
+  inset: -1px;
+  padding: 1.5px;
+  background: radial-gradient(
+    var(--glow-radius) circle at var(--glow-x) var(--glow-y),
+    rgba(var(--glow-color), calc(var(--glow-intensity) * 0.6)) 0%,
+    rgba(var(--glow-color), calc(var(--glow-intensity) * 0.3)) 30%,
+    transparent 60%
+  );
+  border-radius: inherit;
+  -webkit-mask:
+    linear-gradient(#fff 0 0) content-box,
+    linear-gradient(#fff 0 0);
+  -webkit-mask-composite: xor;
+  mask:
+    linear-gradient(#fff 0 0) content-box,
+    linear-gradient(#fff 0 0);
+  mask-composite: exclude;
+  pointer-events: none;
+  opacity: 1;
+  transition: opacity 0.3s ease;
+  z-index: 1;
+}
+
+.magic-badge--border-glow:hover {
+  /* Border only, no glow shadow */
+}
+
+.particle-container {
+  position: relative;
+}
+
+.particle::before {
+  content: '';
+  position: absolute;
+  top: -1px;
+  left: -1px;
+  right: -1px;
+  bottom: -1px;
+  background: rgba(var(--glow-color), 0.25);
+  border-radius: 50%;
+  z-index: -1;
+}
+
+/* Global spotlight ΓÇö screen blend works best on dark backgrounds */
+.global-spotlight {
+  mix-blend-mode: screen;
+  will-change: transform, opacity;
+  z-index: 200 !important;
+  pointer-events: none;
+}

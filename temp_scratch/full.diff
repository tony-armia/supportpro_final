+++ b/src/styles.css
@@ -0,0 +1,283 @@
+@import "tailwindcss" source(none);
+@source "../src";
+@import "tw-animate-css";
+
+@custom-variant dark (&:is(.dark *));
+
+@theme inline {
+  --font-display: "Instrument Serif", ui-serif, Georgia, serif;
+  --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
+  --radius-sm: calc(var(--radius) - 4px);
+  --radius-md: calc(var(--radius) - 2px);
+  --radius-lg: var(--radius);
+  --radius-xl: calc(var(--radius) + 4px);
+  --radius-2xl: calc(var(--radius) + 8px);
+  --radius-3xl: calc(var(--radius) + 12px);
+  --color-background: var(--background);
+  --color-foreground: var(--foreground);
+  --color-card: var(--card);
+  --color-card-foreground: var(--card-foreground);
+  --color-popover: var(--popover);
+  --color-popover-foreground: var(--popover-foreground);
+  --color-primary: var(--primary);
+  --color-primary-foreground: var(--primary-foreground);
+  --color-secondary: var(--secondary);
+  --color-secondary-foreground: var(--secondary-foreground);
+  --color-muted: var(--muted);
+  --color-muted-foreground: var(--muted-foreground);
+  --color-accent: var(--accent);
+  --color-accent-foreground: var(--accent-foreground);
+  --color-destructive: var(--destructive);
+  --color-destructive-foreground: var(--destructive-foreground);
+  --color-border: var(--border);
+  --color-input: var(--input);
+  --color-ring: var(--ring);
+  --color-cream: var(--cream);
+  --color-ink: var(--ink);
+  --color-accent-yellow: var(--accent-yellow);
+}
+
+/* ΓöÇΓöÇΓöÇ Light Mode (default) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */
+:root {
+  --radius: 1rem;
+
+  /* Background hierarchy */
+  --sp-bg:           #FDFAF5;
+  --sp-surface:      #F5F0E8;
+  --sp-surface-el:   #FFFFFF;
+  --sp-surface-soft: #EDE8E0;
+  --sp-footer:       #1A1A18;
+  --sp-input-bg:     #F4EFE8;
+
+  /* Typography */
+  --sp-text-primary:   #1A1A18;
+  --sp-text-secondary: #5A5A54;
+  --sp-text-muted:     #9A9A94;
+
+  /* Borders */
+  --sp-border:        rgba(0,0,0,0.10);
+  --sp-border-strong: rgba(0,0,0,0.18);
+
+  /* Brand accent ΓÇö same in both themes */
+  --sp-accent: #FF8101;
+
+  /* MagicBadge blend mode */
+  --blend-mode: multiply;
+
+  /* ΓöÇΓöÇ Tailwind aliases ΓöÇΓöÇ */
+  --background: #FDFAF5;
+  --foreground: #1A1A18;
+  --cream: #FDFAF5;
+  --ink:   #1A1A18;
+  --accent-yellow: #FF8101;
+
+  --card:               #FFFFFF;
+  --card-foreground:    #1A1A18;
+  --popover:            #FFFFFF;
+  --popover-foreground: #1A1A18;
+
+  --primary:            #FF8101;
+  --primary-foreground: #FFFFFF;
+
+  --secondary:            #F0EBE3;
+  --secondary-foreground: #1A1A18;
+
+  --muted:            #F0EBE3;
+  --muted-foreground: #5A5A54;
+
+  --accent:            #F0EBE3;
+  --accent-foreground: #1A1A18;
+
+  --destructive:            oklch(0.577 0.245 27.325);
+  --destructive-foreground: oklch(0.984 0.003 247.858);
+
+  --border: rgba(0,0,0,0.10);
+  --input:  rgba(0,0,0,0.10);
+  --ring:   #FF8101;
+}
+
+/* ΓöÇΓöÇΓöÇ Dark Mode ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */
+[data-theme="dark"] {
+  /* Background hierarchy */
+  --sp-bg:           #0B0B0B;
+  --sp-surface:      #101010;
+  --sp-surface-el:   #151515;
+  --sp-surface-soft: #1A1A1A;
+  --sp-footer:       #080808;
+  --sp-input-bg:     #0D0D0D;
+
+  /* Typography */
+  --sp-text-primary:   #F5F5F2;
+  --sp-text-secondary: #A7A7A3;
+  --sp-text-muted:     #777773;
+
+  /* Borders */
+  --sp-border:        rgba(255,255,255,0.10);
+  --sp-border-strong: rgba(255,255,255,0.16);
+
+  /* MagicBadge blend mode */
+  --blend-mode: screen;
+
+  /* ΓöÇΓöÇ Tailwind aliases ΓöÇΓöÇ */
+  --background: #0B0B0B;
+  --foreground: #F5F5F2;
+  --cream: #0B0B0B;
+  --ink:   #F5F5F2;
+
+  --card:               #151515;
+  --card-foreground:    #F5F5F2;
+  --popover:            #151515;
+  --popover-foreground: #F5F5F2;
+
+  --primary:            #FF8101;
+  --primary-foreground: #0B0B0B;
+
+  --secondary:            #1A1A1A;
+  --secondary-foreground: #F5F5F2;
+
+  --muted:            #151515;
+  --muted-foreground: #A7A7A3;
+
+  --accent:            #1A1A1A;
+  --accent-foreground: #F5F5F2;
+
+  --destructive:            oklch(0.577 0.245 27.325);
+  --destructive-foreground: oklch(0.984 0.003 247.858);
+
+  --border: rgba(255,255,255,0.10);
+  --input:  rgba(255,255,255,0.10);
+  --ring:   #FF8101;
+}
+
+@layer base {
+  * {
+    border-color: var(--color-border);
+    /* Depth via borders + tonal bgs only ΓÇö no box-shadows */
+    box-shadow: none !important;
+  }
+
+  html {
+    scroll-behavior: smooth;
+    -webkit-overflow-scrolling: touch;
+  }
+
+  body {
+    background-color: var(--sp-bg);
+    color: var(--sp-text-primary);
+    font-family: var(--font-sans);
+    font-feature-settings: "ss01", "cv11";
+    -webkit-font-smoothing: antialiased;
+    text-rendering: optimizeSpeed;
+    transition: background-color 0.35s ease, color 0.35s ease;
+  }
+
+  .font-display {
+    font-family: var(--font-display);
+    font-weight: 400;
+    letter-spacing: -0.012em;
+  }
+
+  img {
+    will-change: auto;
+  }
+
+  .parallax-img {
+    will-change: transform;
+    backface-visibility: hidden;
+    -webkit-backface-visibility: hidden;
+  }
+
+  :focus-visible {
+    outline: 2px solid var(--sp-accent);
+    outline-offset: 2px;
+  }
+}
+
+@media (pointer: fine) and (prefers-reduced-motion: no-preference) {
+  html,
+  body,
+  a,
+  button,
+  input,
+  textarea,
+  select,
+  [role="button"] {
+    cursor: none !important;
+  }
+}
+
+/* ΓöÇΓöÇΓöÇ Reduced-motion overrides ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+  }
+}
+
+/* ΓöÇΓöÇΓöÇ Marquee animations ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */
+@keyframes marquee {
+  from { transform: translateX(0); }
+  to   { transform: translateX(-50%); }
+}
+@keyframes marquee-reverse {
+  from { transform: translateX(-50%); }
+  to   { transform: translateX(0); }
+}
+
+.animate-marquee {
+  animation: marquee 30s linear infinite;
+  will-change: transform;
+  backface-visibility: hidden;
+  -webkit-backface-visibility: hidden;
+  transform: translateZ(0);
+}
+.animate-marquee-reverse {
+  animation: marquee-reverse 30s linear infinite;
+  will-change: transform;
+  backface-visibility: hidden;
+  -webkit-backface-visibility: hidden;
+  transform: translateZ(0);
+}
+
+.animate-marquee:hover,
+.animate-marquee-reverse:hover {
+  animation-play-state: paused;
+}
+
+/* Smooth slider scroll */
+.slider-track {
+  contain: layout style;
+}
+
+/* ΓöÇΓöÇΓöÇ Blob animations ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */
+@keyframes blob-drift-a {
+  0%, 100% { transform: translate(0, 0) scale(1); }
+  33%       { transform: translate(40px, -40px) scale(1.15); }
+  66%       { transform: translate(-20px, 20px) scale(0.9); }
+}
+@keyframes blob-drift-b {
+  0%, 100% { transform: translate(0, 0) scale(1); }
+  33%       { transform: translate(-50px, 50px) scale(1.2); }
+  66%       { transform: translate(30px, -30px) scale(0.85); }
+}
+
+.blob-a {
+  animation: blob-drift-a 18s ease-in-out infinite;
+  will-change: transform;
+  backface-visibility: hidden;
+}
+
+.blob-b {
+  animation: blob-drift-b 22s ease-in-out infinite;
+  will-change: transform;
+  backface-visibility: hidden;
+}
+
+/* ΓöÇΓöÇΓöÇ Theme-transition helper ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */
+/* Applied to all sections so bg/color changes animate smoothly */
+section, nav, footer, main {
+  transition: background-color 0.35s ease, border-color 0.35s ease, color 0.25s ease;
+}
